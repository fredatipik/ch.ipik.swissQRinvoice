msgid "Manage message templates"
msgstr "Gérer les modèles de messages"

#: templates/CRM/SwissQRInvoice/Form/Settings.tpl:33
msgid ""
"Search for <strong>swissqrinvoice_send</strong> in the User-Driven Messages "
"list to edit the invoice email template."
msgstr ""
"Cherchez <strong>swissqrinvoice_send</strong> dans la liste des messages "
"utilisateur pour modifier le modèle d'email de facture."

#: templates/CRM/SwissQRInvoice/Form/Settings.tpl:37
