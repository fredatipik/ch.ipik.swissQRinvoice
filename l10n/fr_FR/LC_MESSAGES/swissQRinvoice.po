#: templates/CRM/SwissQRInvoice/Form/Bulk.tpl:12
msgid ""
"Pick a service from the catalogue, or leave on free entry and fill in the "
"fields below. Fields you fill in override the service."
msgstr ""
"Choisissez une prestation du catalogue, ou restez en saisie libre et "
"remplissez les champs ci-dessous. Les champs remplis priment sur la "
"prestation."

#: templates/CRM/SwissQRInvoice/Form/Invoice.tpl:23
msgid "Leave blank for automatic numbering"
msgstr "Laisser vide pour une numérotation automatique"

#: templates/CRM/SwissQRInvoice/Form/MarkPaid.tpl:24
msgid ""
"The payment is recorded on the invoice's contribution. An amount lower than "
"the balance leaves the invoice partially paid."
msgstr ""
"Le paiement est enregistré sur la contribution de la facture. Un montant "
"inférieur au solde laisse la facture partiellement payée."

