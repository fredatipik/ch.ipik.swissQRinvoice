msgstr "Décalage horizontal du logo vers la droite"

#: templates/CRM/SwissQRInvoice/Form/Settings.tpl:13
msgid "Additional space between the bottom of the logo and the address"
msgstr "Espace supplémentaire entre le bas du logo et l'adresse"

#: templates/CRM/SwissQRInvoice/Form/Settings.tpl:17
msgid "Positive value = moves down, negative = moves up."
msgstr "Valeur positive = descend, négative = monte."

#: templates/CRM/SwissQRInvoice/Form/Settings.tpl:21
msgid "PDF — Layout"
msgstr "PDF — Mise en page"

#: templates/CRM/SwissQRInvoice/Form/Settings.tpl:22
msgid ""
"The payment part is printed at the bottom of the first page when the invoice"
" leaves enough room; longer invoices automatically keep it on a second page."
msgstr ""
"La section paiement est imprimée au bas de la première page quand la facture"
" laisse assez de place ; les factures plus longues la gardent "
"automatiquement sur une deuxième page."

#: templates/CRM/SwissQRInvoice/Form/Settings.tpl:24
msgid "Numbering"
msgstr "Numérotation"

#: templates/CRM/SwissQRInvoice/Form/Settings.tpl:25
msgid "Variables: {YEAR} = year, {SEQ:4} = sequence of 4 digits"
msgstr ""
"Variables : {YEAR} = année, {SEQ:4} = numéro séquentiel sur 4 chiffres"

#: templates/CRM/SwissQRInvoice/Form/Settings.tpl:26
msgid "Variable: {NUMBER} = invoice number"
msgstr "Variable : {NUMBER} = numéro de facture"

