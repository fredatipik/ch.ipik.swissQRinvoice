<?xml version="1.0"?>
<extension key="ch.ipik.swissQRinvoice" type="module">
  <file>swissQRinvoice</file>
  <name>Swiss QR Invoice</name>
  <description>Generate PDF invoices with Swiss QR-bill (Swiss Payment Standard) for CiviCRM contacts. Supports manual invoice creation, dynamic line items, service catalog, email sending with customizable templates, mark-as-paid linked to CiviCRM contributions, and a contact tab showing invoice history.</description>
  <license>AGPL-3.0</license>
  <maintainer>
    <name>Frédéric Hiltbrand / IPIK</name>
    <email>fh@ipik.ch</email>
  </maintainer>
  <urls>
    <url desc="Main">https://lab.civicrm.org/extensions/swissqrinvoice</url>
    <url desc="Documentation">https://lab.civicrm.org/extensions/swissqrinvoice/-/blob/main/README.md</url>
    <url desc="Bugs">https://lab.civicrm.org/extensions/swissqrinvoice/-/issues</url>
  </urls>
  <releaseDate>2026-09-23</releaseDate>
  <version>0.36</version>
  <develStage>alpha</develStage>
  <compatibility>
    <ver>6.0</ver>
  </compatibility>
 
  <mixins>
    <mixin>menu-xml@1</mixin>
    <mixin>scan-classes@1</mixin>
    <mixin>setting-php@1</mixin>
  </mixins>
</extension>
